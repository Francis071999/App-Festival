# Copia este archivo a .env y completa los dos valores.
#
# VITE_SUPABASE_URL       -> Supabase > Project Settings > API Keys > Project URL
#                            (ej: https://abcdefgh.supabase.co)
# VITE_SUPABASE_ANON_KEY  -> la "publishable key" (sb_publishable_...) o la
#                            "anon" legacy (eyJ...). Las dos son publicas y
#                            estan protegidas por RLS.
#                            NUNCA pongas aca la secret key (sb_secret_...) ni
#                            la service_role: esas bypassean RLS.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
